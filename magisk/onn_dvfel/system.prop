# Applied by Magisk in memory early in boot, before SurfaceFlinger starts.
#
# SurfaceFlinger's "GL early" phase offset, used when a client-composed layer is on screen
# (Kodi's GUI; on this box the whole UI is GPU-composed). The vendor value of 1 ms woke
# SurfaceFlinger before the present fence of a FEL frame had signalled (2-4.5 ms after vsync),
# so at 24 Hz it skipped a vsync and dropped one of the two video buffers then due: Kodi FEL at
# 2160p24 lost 7-10 frames per second. 4 ms (the vendor's own normal SF offset,
# ro.surface_flinger.vsync_sf_event_phase_offset_ns): ~0.15 per second, and the smallest UI
# cost that fixes it (8-12 ms cost missed frames on app launches and launcher scrolling).
# Measured by the players session on the CA box, 2026-11-20. Kodi FEL (players' patch) only
# switches to 24 Hz for FEL when this is >= 4000000.
debug.sf.early_gl_phase_offset_ns=4000000

# EL decoder buffers (24 Hz frame loss). The C2 decoder gets dpb + this margin output buffers
# (default 6: 12 for the EL). libdvfelplay keeps "kernel + decoder" under sc2_buffers (default 7), so
# the EL arrived just in time and ~3 frames/s were held for it, each costing a SurfaceFlinger drop.
# margin 12 (18 buffers) + sc2_buffers 11: holds ~160 -> 1 per 60 s play, 0 lost (A/B 2026-11-25).
# margin 10 + sc2_buffers 10 was unstable (one stock-like play, green eyes seen): do not use 10.
# margin 12 still ran the EL decoder out of output buffers at every keyframe (~1/s; EL in->out 320-425 ms):
# .111 (display-led) SMB full Grinch 150 s lost 45/8. margin 20 (26 buffers): 0-1 holds, 0 lost on .111 SMB,
# .141 local and VLC .111 (players session, 2026-11-26); 16 still held, 18 was the first clean one.
# sc2_buffers stays 11: 16 (with ahead 16) sent frames without their EL (green).
# The margin is read by the C2 HAL for every decoder it creates (all apps). MemAvailable during FEL
# 1.04 GB vs 1.12 GB at 12.
vendor.media.c2.vdec.margin=20
debug.dvfp.sc2_buffers=11
